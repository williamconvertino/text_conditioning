# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored and is loaded by the slurm scripts via
# `set -a; source .env; set +a` -- never commit real secrets here or
# hardcode them directly in a slurm script.

# Required by tokenize_fineweb.slurm, train*.slurm, and evaluate*.slurm.
# Must belong to an HF account that has accepted the meta-llama/Llama-3.2-3B
# license, or tokenizer/model loading will fail with a 401.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Add any other keys your experiments need below, e.g.:
# WANDB_API_KEY=
